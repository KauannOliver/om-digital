# Vite application path and API settings
VITE_BASE_PATH=/
VITE_HTTP_TIMEOUT_MS=60000
VITE_HOME_CACHE_MS=86400000
VITE_HTTP_CACHE=no-store
VITE_API_PROXY_TARGET=http://localhost:3001
VITE_API_BASE=
VITE_GLOBAL_SYNC_MS=120000
VITE_SIDEPANEL_SYNC_MS=60000
VITE_IDLE_TIMEOUT_MS=600000

# Express server and cache settings
PORT=3001
CACHE_TTL_MS=60000
HOME_CACHE_TTL_MS=86400000
ORDERS_CACHE_TTL_MS=60000
ASSETS_CACHE_TTL_MS=60000

# MySQL connection; use an authorized, least-privilege account
DB_HOST=your-mysql-host.example.com
DB_NAME=your_database
DB_USER=readonly_user
DB_PASSWORD=
DB_PORT=3306
DB_SSL=true
